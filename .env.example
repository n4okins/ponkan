POSTGRES_DB=ponkan
POSTGRES_USER=ponkan
POSTGRES_PASSWORD=replace-with-a-long-random-password
PONKAN_PORT=8080

# Optional. When set, /api/v1/* (except health) and /mcp require Authorization: Bearer <token>.
PONKAN_API_TOKEN=

# MCP DNS-rebinding protection. Add the LAN IP / DNS name you actually use.
# Example: localhost,localhost:*,127.0.0.1,127.0.0.1:*,192.168.1.20,192.168.1.20:*,ponkan.home.arpa,ponkan.home.arpa:*
PONKAN_MCP_ALLOWED_HOSTS=localhost,localhost:*,127.0.0.1,127.0.0.1:*
PONKAN_MCP_ALLOWED_ORIGINS=

# CSV import is deliberately allowlisted to reduce SSRF risk.
PONKAN_IMPORT_ALLOWED_HOSTS=docs.google.com,googleusercontent.com
PONKAN_SEED_DEMO=true
PONKAN_FORWARDED_ALLOW_IPS=127.0.0.1
